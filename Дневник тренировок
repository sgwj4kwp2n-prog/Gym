<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0A0E17">
<title>FitLog</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  :root {
    --bg: #0A0E17;
    --card: #1A1F2E;
    --card2: #232938;
    --accent: #00E676;
    --accent2: #FF6B35;
    --text: #FFFFFF;
    --muted: #8A93A6;
    --danger: #FF4D5E;
  }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding-bottom: 90px;
    overflow-x: hidden;
  }
  .header {
    padding: 20px 20px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 10;
  }
  .header h1 { font-size: 28px; font-weight: 800; letter-spacing: -0.5px; }
  .add-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: #000;
    border: none;
    font-size: 26px;
    font-weight: 600;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0,230,118,0.35);
  }
  .add-btn:active { transform: scale(0.92); }

  /* Chips категорий */
  .chips {
    display: flex;
    gap: 10px;
    padding: 4px 20px 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    padding: 9px 18px;
    border-radius: 20px;
    background: var(--card);
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  .chip.active {
    background: var(--accent);
    color: #000;
  }

  /* Список упражнений */
  .list { padding: 0 20px; display: flex; flex-direction: column; gap: 12px; }
  .card {
    background: var(--card);
    border-radius: 18px;
    padding: 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .card:active { background: var(--card2); }
  .card-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    background: rgba(0,230,118,0.12);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
  }
  .card-icon.cardio { background: rgba(255,107,53,0.12); }
  .card-body { flex: 1; min-width: 0; }
  .card-title {
    font-size: 16px; font-weight: 600;
    display: flex; align-items: center; gap: 8px;
    flex-wrap: wrap;
  }
  .badge {
    font-size: 10px; font-weight: 700;
    padding: 2px 7px; border-radius: 20px;
    background: rgba(255,107,53,0.2);
    color: var(--accent2);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .card-sub { font-size: 13px; color: var(--muted); margin-top: 3px; }
  .chevron { color: var(--muted); font-size: 20px; }
  .empty {
    text-align: center; color: var(--muted);
    padding: 60px 20px; font-size: 15px;
  }

  /* Нижняя навигация */
  .tabbar {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: rgba(26,31,46,0.95);
    backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255,255,255,0.06);
    display: flex;
    padding: 10px 0 calc(10px + env(safe-area-inset-bottom));
    z-index: 20;
  }
  .tab {
    flex: 1;
    display: flex; flex-direction: column;
    align-items: center; gap: 4px;
    background: none; border: none;
    color: var(--muted);
    font-size: 11px; font-weight: 600;
    cursor: pointer;
    padding: 6px 0;
  }
  .tab.active { color: var(--accent); }
  .tab .ico { font-size: 22px; }

  /* Модальное окно (sheet) */
  .overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 30;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s;
  }
  .overlay.show { opacity: 1; pointer-events: auto; }
  .sheet {
    position: fixed; left: 0; right: 0; bottom: 0;
    background: var(--bg);
    border-radius: 24px 24px 0 0;
    z-index: 40;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.32,0.72,0,1);
    max-height: 92vh;
    display: flex; flex-direction: column;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .sheet.show { transform: translateY(0); }
  .sheet-handle {
    width: 40px; height: 5px;
    background: rgba(255,255,255,0.2);
    border-radius: 3px;
    margin: 10px auto 6px;
  }
  .sheet-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 20px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .sheet-title { font-size: 20px; font-weight: 700; }
  .sheet-close {
    background: var(--card); color: var(--text);
    border: none; border-radius: 50%;
    width: 32px; height: 32px;
    font-size: 16px; cursor: pointer;
  }
  .sheet-content {
    overflow-y: auto;
    padding: 20px;
    flex: 1;
  }

  /* Формы */
  .field { margin-bottom: 18px; }
  .field label {
    display: block;
    font-size: 13px; font-weight: 600;
    color: var(--muted);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .field input, .field textarea {
    width: 100%;
    padding: 14px 16px;
    background: var(--card);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px;
    color: var(--text);
    font-size: 16px;
    font-family: inherit;
    outline: none;
    transition: border 0.2s;
  }
  .field input:focus, .field textarea:focus { border-color: var(--accent); }
  .field textarea { resize: vertical; min-height: 70px; }
  .field input::placeholder, .field textarea::placeholder { color: #5A6274; }

  .segmented {
    display: flex;
    background: var(--card);
    border-radius: 12px;
    padding: 4px;
    gap: 4px;
  }
  .segmented button {
    flex: 1;
    padding: 10px;
    background: none;
    border: none;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    border-radius: 9px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .segmented button.active {
    background: var(--accent);
    color: #000;
  }

  .icons-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
  }
  .icon-opt {
    aspect-ratio: 1;
    display: flex; align-items: center; justify-content: center;
    background: var(--card);
    border-radius: 12px;
    font-size: 22px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.2s;
  }
  .icon-opt.selected {
    border-color: var(--accent);
    background: rgba(0,230,118,0.12);
  }

  .btn-primary {
    width: 100%;
    padding: 16px;
    background: var(--accent);
    color: #000;
    border: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 8px;
    transition: transform 0.15s;
  }
  .btn-primary:active { transform: scale(0.97); }
  .btn-primary:disabled { opacity: 0.4; }

  .btn-secondary {
    width: 100%;
    padding: 14px;
    background: var(--card);
    color: var(--text);
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
  }

  /* Подходы */
  .set-row {
    display: flex; gap: 10px;
    align-items: center;
    background: var(--card);
    border-radius: 14px;
    padding: 12px;
    margin-bottom: 10px;
  }
  .set-num {
    width: 28px; height: 28px;
    background: rgba(0,230,118,0.12);
    color: var(--accent);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700;
    flex-shrink: 0;
  }
  .set-field { flex: 1; }
  .set-field label { font-size: 10px; color: var(--muted); display: block; margin-bottom: 2px; }
  .set-field input {
    background: transparent;
    border: none;
    color: var(--text);
    font-size: 18px;
    font-weight: 600;
    width: 100%;
    outline: none;
    font-family: inherit;
  }
  .set-del {
    background: rgba(255,77,94,0.12);
    color: var(--danger);
    border: none;
    width: 32px; height: 32px;
    border-radius: 50%;
    font-size: 16px;
    cursor: pointer;
    flex-shrink: 0;
  }

  /* История */
  .history-item {
    background: var(--card);
    border-radius: 14px;
    padding: 12px 16px;
    margin-bottom: 10px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .history-date { font-size: 12px; color: var(--muted); }
  .history-value { font-size: 16px; font-weight: 600; }
  .history-cardio { font-size: 14px; }

  .stat-card {
    background: linear-gradient(135deg, var(--card), var(--card2));
    border-radius: 18px;
    padding: 18px;
    margin-bottom: 12px;
  }
  .stat-label { font-size: 13px; color: var(--muted); margin-bottom: 6px; }
  .stat-value { font-size: 28px; font-weight: 800; color: var(--accent); }

  .toast {
    position: fixed;
    bottom: 100px; left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--accent);
    color: #000;
    padding: 12px 24px;
    border-radius: 30px;
    font-weight: 700;
    font-size: 14px;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s;
    z-index: 100;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>
</head>
<body>

<div class="header">
  <h1 id="pageTitle">Упражнения</h1>
  <button class="add-btn" id="addBtn">+</button>
</div>

<div class="chips" id="chips"></div>
<div class="list" id="list"></div>

<div class="tabbar">
  <button class="tab active" data-tab="exercises">
    <span class="ico">🏋️</span>
    <span>Упражнения</span>
  </button>
  <button class="tab" data-tab="history">
    <span class="ico">📊</span>
    <span>История</span>
  </button>
</div>

<!-- Оверлей -->
<div class="overlay" id="overlay"></div>

<!-- Sheet: добавление упражнения -->
<div class="sheet" id="sheetAddExercise">
  <div class="sheet-handle"></div>
  <div class="sheet-header">
    <div class="sheet-title">Новое упражнение</div>
    <button class="sheet-close" data-close>✕</button>
  </div>
  <div class="sheet-content">
    <div class="field">
      <label>Название</label>
      <input type="text" id="exName" placeholder="Например: Жим гантелей сидя">
    </div>
    <div class="field">
      <label>Категория</label>
      <div class="segmented" id="exCategory">
        <button data-val="free" class="active">Свободные</button>
        <button data-val="machine">Тренажёры</button>
        <button data-val="cardio">Кардио</button>
      </div>
    </div>
    <div class="field" id="muscleField">
      <label>Группа мышц</label>
      <div class="segmented" id="exMuscle" style="flex-wrap: wrap;">
        <button data-val="Грудь" class="active">Грудь</button>
        <button data-val="Спина">Спина</button>
        <button data-val="Ноги">Ноги</button>
        <button data-val="Плечи">Плечи</button>
        <button data-val="Руки">Руки</button>
        <button data-val="Пресс">Пресс</button>
      </div>
    </div>
    <div class="field">
      <label>Иконка</label>
      <div class="icons-grid" id="exIcons"></div>
    </div>
    <div class="field">
      <label>Заметки (необязательно)</label>
      <textarea id="exNotes" placeholder="Техника, советы..."></textarea>
    </div>
    <button class="btn-primary" id="saveExercise" disabled>Сохранить</button>
  </div>
</div>

<!-- Sheet: детали упражнения -->
<div class="sheet" id="sheetDetail">
  <div class="sheet-handle"></div>
  <div class="sheet-header">
    <div class="sheet-title" id="detailTitle">Упражнение</div>
    <button class="sheet-close" data-close>✕</button>
  </div>
  <div class="sheet-content" id="detailContent"></div>
</div>

<div class="toast" id="toast"></div>

<script>
// ============ ДАННЫЕ ============
const STORAGE_KEY = 'fitlog_data_v1';

const DEFAULT_EXERCISES = [
  // Свободные веса
  { id: 'fw1', name: 'Жим штанги лёжа', category: 'free', muscle: 'Грудь', icon: '🏋️', custom: false },
  { id: 'fw2', name: 'Приседания со штангой', category: 'free', muscle: 'Ноги', icon: '🦵', custom: false },
  { id: 'fw3', name: 'Становая тяга', category: 'free', muscle: 'Спина', icon: '🏋️', custom: false },
  { id: 'fw4', name: 'Жим стоя', category: 'free', muscle: 'Плечи', icon: '💪', custom: false },
  { id: 'fw5', name: 'Тяга в наклоне', category: 'free', muscle: 'Спина', icon: '🏋️', custom: false },
  { id: 'fw6', name: 'Выпады с гантелями', category: 'free', muscle: 'Ноги', icon: '🦵', custom: false },
  { id: 'fw7', name: 'Подъём на бицепс', category: 'free', muscle: 'Руки', icon: '💪', custom: false },
  { id: 'fw8', name: 'Французский жим', category: 'free', muscle: 'Руки', icon: '💪', custom: false },
  { id: 'fw9', name: 'Разведения гантелей', category: 'free', muscle: 'Грудь', icon: '🏋️', custom: false },
  { id: 'fw10', name: 'Шраги с гантелями', category: 'free', muscle: 'Плечи', icon: '💪', custom: false },
  // Тренажёры
  { id: 'mc1', name: 'Жим ногами', category: 'machine', muscle: 'Ноги', icon: '🦵', custom: false },
  { id: 'mc2', name: 'Разгибание ног', category: 'machine', muscle: 'Ноги', icon: '🦵', custom: false },
  { id: 'mc3', name: 'Сгибание ног', category: 'machine', muscle: 'Ноги', icon: '🦵', custom: false },
  { id: 'mc4', name: 'Кроссовер', category: 'machine', muscle: 'Грудь', icon: '🏋️', custom: false },
  { id: 'mc5', name: 'Тяга верхнего блока', category: 'machine', muscle: 'Спина', icon: '🏋️', custom: false },
  { id: 'mc6', name: 'Тяга нижнего блока', category: 'machine', muscle: 'Спина', icon: '🏋️', custom: false },
  { id: 'mc7', name: 'Бабочка (Peck-Deck)', category: 'machine', muscle: 'Грудь', icon: '🦋', custom: false },
  { id: 'mc8', name: 'Смит-машина', category: 'machine', muscle: 'Грудь', icon: '🏋️', custom: false },
  { id: 'mc9', name: 'Гакк-приседания', category: 'machine', muscle: 'Ноги', icon: '🦵', custom: false },
  { id: 'mc10', name: 'Трицепс на блоке', category: 'machine', muscle: 'Руки', icon: '💪', custom: false },
  // Кардио
  { id: 'cd1', name: 'Беговая дорожка', category: 'cardio', muscle: 'Всё тело', icon: '🏃', custom: false },
  { id: 'cd2', name: 'Эллипс', category: 'cardio', muscle: 'Всё тело', icon: '🏃', custom: false },
  { id: 'cd3', name: 'Велотренажёр', category: 'cardio', muscle: 'Всё тело', icon: '🚴', custom: false },
  { id: 'cd4', name: 'Гребной тренажёр', category: 'cardio', muscle: 'Всё тело', icon: '🚣', custom: false },
  { id: 'cd5', name: 'Скакалка', category: 'cardio', muscle: 'Всё тело', icon: '🤸', custom: false },
  { id: 'cd6', name: 'Степпер', category: 'cardio', muscle: 'Всё тело', icon: '🪜', custom: false },
  { id: 'cd7', name: 'HIIT', category: 'cardio', muscle: 'Всё тело', icon: '🔥', custom: false },
];

const CATEGORY_NAMES = { free: 'Свободные веса', machine: 'Тренажёры', cardio: 'Кардио' };

const ICON_OPTIONS = ['🏋️','💪','🦵','🏃','🚴','🚣','🤸','🔥','🦋','🪜','⏱️','🎯'];

// ============ СОСТОЯНИЕ ============
let state = loadState();
let currentCategory = 'all';
let currentTab = 'exercises';
let currentExercise = null;

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch(e) {}
  return {
    exercises: DEFAULT_EXERCISES.map(e => ({...e, sets: [], cardio: []})),
  };
}

function saveState() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e) { showToast('Ошибка сохранения'); }
}

// ============ УТИЛИТЫ ============
function $(sel) { return document.querySelector(sel); }
function $$(sel) { return document.querySelectorAll(sel); }
function uid() { return 'ex_' + Date.now() + '_' + Math.random().toString(36).slice(2,7); }
function fmtDate(ts) {
  const d = new Date(ts);
  return d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' }) + ' ' +
         d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
}

let toastTimer;
function showToast(msg) {
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 1800);
}

// ============ РЕНДЕР СПИСКА ============
function renderChips() {
  const chips = $('#chips');
  const cats = [
    { val: 'all', label: 'Все' },
    { val: 'free', label: 'Свободные' },
    { val: 'machine', label: 'Тренажёры' },
    { val: 'cardio', label: 'Кардио' },
  ];
  chips.innerHTML = cats.map(c =>
    `<button class="chip ${currentCategory === c.val ? 'active' : ''}" data-cat="${c.val}">${c.label}</button>`
  ).join('');
  chips.querySelectorAll('.chip').forEach(btn => {
    btn.onclick = () => { currentCategory = btn.dataset.cat; renderChips(); renderList(); };
  });
}

function renderList() {
  const list = $('#list');
  let items = state.exercises;
  if (currentCategory !== 'all') items = items.filter(e => e.category === currentCategory);

  if (items.length === 0) {
    list.innerHTML = `<div class="empty">Пока нет упражнений<br>Нажмите «+» чтобы добавить</div>`;
    return;
  }

  list.innerHTML = items.map(ex => {
    const isCardio = ex.category === 'cardio';
    const lastSet = ex.sets && ex.sets.length ? ex.sets[ex.sets.length - 1] : null;
    const lastCardio = ex.cardio && ex.cardio.length ? ex.cardio[ex.cardio.length - 1] : null;
    let sub = CATEGORY_NAMES[ex.category] + ' · ' + ex.muscle;
    if (lastSet) sub = `Прошлый раз: ${lastSet.weight} кг × ${lastSet.reps}`;
    if (lastCardio) sub = `Прошлый раз: ${lastCardio.minutes} мин · ${lastCardio.calories} ккал`;

    return `
      <div class="card" data-id="${ex.id}">
        <div class="card-icon ${isCardio ? 'cardio' : ''}">${ex.icon}</div>
        <div class="card-body">
          <div class="card-title">
            ${escapeHtml(ex.name)}
            ${ex.custom ? '<span class="badge">своё</span>' : ''}
          </div>
          <div class="card-sub">${escapeHtml(sub)}</div>
        </div>
        <div class="chevron">›</div>
      </div>
    `;
  }).join('');

  list.querySelectorAll('.card').forEach(card => {
    card.onclick = () => openDetail(card.dataset.id);
  });
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// ============ РЕНДЕР ИСТОРИИ ============
function renderHistory() {
  const list = $('#list');
  const chips = $('#chips');
  chips.innerHTML = '';
  $('#pageTitle').textContent = 'История';

  // Собираем все записи
  const records = [];
  state.exercises.forEach(ex => {
    (ex.sets || []).forEach(s => records.push({ type:'set', ex, s, ts: s.ts }));
    (ex.cardio || []).forEach(c => records.push({ type:'cardio', ex, c, ts: c.ts }));
  });
  records.sort((a,b) => b.ts - a.ts);

  if (records.length === 0) {
    list.innerHTML = `<div class="empty">История пуста<br>Добавьте первую тренировку</div>`;
    return;
  }

  // Статистика
  const totalWorkouts = new Set(records.map(r => new Date(r.ts).toDateString())).size;
  const totalSets = records.filter(r => r.type === 'set').length;
  const totalCalories = records.filter(r => r.type === 'cardio').reduce((a,r) => a + r.c.calories, 0);
  const totalMinutes = records.filter(r => r.type === 'cardio').reduce((a,r) => a + r.c.minutes, 0);

  let html = `
    <div class="stat-card">
      <div class="stat-label">Всего тренировок</div>
      <div class="stat-value">${totalWorkouts}</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
      <div class="stat-card" style="margin:0">
        <div class="stat-label">Подходов</div>
        <div class="stat-value" style="font-size:22px">${totalSets}</div>
      </div>
      <div class="stat-card" style="margin:0">
        <div class="stat-label">Ккал сожжено</div>
        <div class="stat-value" style="font-size:22px">${totalCalories}</div>
      </div>
    </div>
  `;

  records.slice(0, 50).forEach(r => {
    if (r.type === 'set') {
      html += `
        <div class="history-item">
          <div>
            <div class="history-value">${escapeHtml(r.ex.name)}</div>
            <div class="history-date">${fmtDate(r.ts)}</div>
          </div>
          <div class="history-value">${r.s.weight}кг × ${r.s.reps}</div>
        </div>
      `;
    } else {
      html += `
        <div class="history-item">
          <div>
            <div class="history-value">${escapeHtml(r.ex.name)}</div>
            <div class="history-date">${fmtDate(r.ts)}</div>
          </div>
          <div class="history-cardio">⏱ ${r.c.minutes}м · 🔥 ${r.c.calories}</div>
        </div>
      `;
    }
  });

  list.innerHTML = html;
}

// ============ ДЕТАЛИ УПРАЖНЕНИЯ ============
function openDetail(id) {
  const ex = state.exercises.find(e => e.id === id);
  if (!ex) return;
  currentExercise = ex;

  $('#detailTitle').textContent = ex.name;
  renderDetail();
  openSheet('sheetDetail');
}

function renderDetail() {
  const ex = currentExercise;
  if (!ex) return;
  const content = $('#detailContent');
  const isCardio = ex.category === 'cardio';

  let html = `
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
      <div class="card-icon ${isCardio ? 'cardio' : ''}" style="width:56px;height:56px;font-size:28px">${ex.icon}</div>
      <div>
        <div style="font-weight:600">${escapeHtml(ex.muscle)}</div>
        <div style="color:var(--muted);font-size:13px">${CATEGORY_NAMES[ex.category]}</div>
      </div>
    </div>
  `;

  if (ex.notes) {
    html += `<div style="background:var(--card);border-radius:12px;padding:12px;margin-bottom:16px;font-size:14px;color:var(--muted)">${escapeHtml(ex.notes)}</div>`;
  }

  if (isCardio) {
    html += `
      <div class="field">
        <label>Время (минуты)</label>
        <input type="number" id="cardioMin" placeholder="30" min="0" inputmode="numeric">
      </div>
      <div class="field">
        <label>Сожжено ккал</label>
        <input type="number" id="cardioKcal" placeholder="280" min="0" inputmode="numeric">
      </div>
      <button class="btn-primary" id="addCardio">Добавить запись</button>
    `;
  } else {
    html += `<div style="font-size:13px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px">Подходы</div>`;
    html += `<div id="setsList"></div>`;
    html += `
      <div class="set-row" style="margin-top:4px">
        <div class="set-num">+</div>
        <div class="set-field">
          <label>Вес (кг)</label>
          <input type="number" id="newWeight" placeholder="0" step="0.5" min="0" inputmode="decimal">
        </div>
        <div class="set-field">
          <label>Повторения</label>
          <input type="number" id="newReps" placeholder="0" min="1" inputmode="numeric">
        </div>
      </div>
      <button class="btn-primary" id="addSet">Добавить подход</button>
    `;
  }

  // История
  html += `<div style="font-size:13px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin:24px 0 10px">История</div>`;
  const history = isCardio ? (ex.cardio || []).slice().reverse() : (ex.sets || []).slice().reverse();
  if (history.length === 0) {
    html += `<div style="color:var(--muted);font-size:14px;text-align:center;padding:20px">Пока нет записей</div>`;
  } else {
    history.slice(0, 20).forEach((item, idx) => {
      if (isCardio) {
        html += `
          <div class="history-item">
            <div>
              <div class="history-cardio">⏱ ${item.minutes} мин · 🔥 ${item.calories} ккал</div>
              <div class="history-date">${fmtDate(item.ts)}</div>
            </div>
          </div>
        `;
      } else {
        html += `
          <div class="history-item">
            <div>
              <div class="history-value">${item.weight} кг × ${item.reps}</div>
              <div class="history-date">${fmtDate(item.ts)}</div>
            </div>
          </div>
        `;
      }
    });
  }

  // Кнопка удаления для своих
  if (ex.custom) {
    html += `<button class="btn-secondary" id="deleteEx" style="color:var(--danger);margin-top:20px">Удалить упражнение</button>`;
  }

  content.innerHTML = html;
  bindDetailEvents(ex, isCardio);
}

function bindDetailEvents(ex, isCardio) {
  if (isCardio) {
    $('#addCardio').onclick = () => {
      const min = parseInt($('#cardioMin').value);
      const kcal = parseInt($('#cardioKcal').value);
      if (!min || min <= 0) return showToast('Укажите время');
      if (isNaN(kcal) || kcal < 0) return showToast('Укажите ккал');
      if (!ex.cardio) ex.cardio = [];
      ex.cardio.push({ minutes: min, calories: kcal, ts: Date.now() });
      saveState();
      showToast('Записано ✓');
      renderDetail();
      renderList();
    };
  } else {
    renderSetsList(ex);
    $('#addSet').onclick = () => {
      const w = parseFloat($('#newWeight').value);
      const r = parseInt($('#newReps').value);
      if (isNaN(w) || w < 0) return showToast('Укажите вес');
      if (!r || r <= 0) return showToast('Укажите повторения');
      if (!ex.sets) ex.sets = [];
      ex.sets.push({ weight: w, reps: r, ts: Date.now() });
      saveState();
      showToast('Подход добавлен ✓');
      renderDetail();
      renderList();
    };
  }

  if (ex.custom) {
    const delBtn = $('#deleteEx');
    if (delBtn) delBtn.onclick = () => {
      if (confirm('Удалить упражнение и всю его историю?')) {
        state.exercises = state.exercises.filter(e => e.id !== ex.id);
        saveState();
        closeAll();
        renderList();
        showToast('Удалено');
      }
    };
  }
}

function renderSetsList(ex) {
  const container = $('#setsList');
  if (!container) return;
  const sets = ex.sets || [];
  if (sets.length === 0) {
    container.innerHTML = `<div style="color:var(--muted);font-size:13px;padding:8px 0 12px">Ещё нет подходов</div>`;
    return;
  }
  container.innerHTML = sets.map((s, i) => `
    <div class="set-row">
      <div class="set-num">${i+1}</div>
      <div class="set-field">
        <label>Вес (кг)</label>
        <div style="font-size:18px;font-weight:600">${s.weight}</div>
      </div>
      <div class="set-field">
        <label>Повторения</label>
        <div style="font-size:18px;font-weight:600">${s.reps}</div>
      </div>
    </div>
  `).join('');
}

// ============ ДОБАВЛЕНИЕ УПРАЖНЕНИЯ ============
let newExCategory = 'free';
let newExMuscle = 'Грудь';
let newExIcon = '🏋️';

function openAddExercise() {
  $('#exName').value = '';
  $('#exNotes').value = '';
  newExCategory = 'free';
  newExMuscle = 'Грудь';
  newExIcon = '🏋️';
  updateAddFormUI();
  openSheet('sheetAddExercise');
  setTimeout(() => $('#exName').focus(), 300);
}

function updateAddFormUI() {
  // Категория
  $$('#exCategory button').forEach(b => {
    b.classList.toggle('active', b.dataset.val === newExCategory);
  });
  // Группа мышц скрываем для кардио
  $('#muscleField').style.display = newExCategory === 'cardio' ? 'none' : 'block';
  // Иконки
  const grid = $('#exIcons');
  grid.innerHTML = ICON_OPTIONS.map(ic =>
    `<div class="icon-opt ${ic === newExIcon ? 'selected' : ''}" data-icon="${ic}">${ic}</div>`
  ).join('');
  grid.querySelectorAll('.icon-opt').forEach(el => {
    el.onclick = () => { newExIcon = el.dataset.icon; updateAddFormUI(); };
  });
  // Кнопка
  $('#saveExercise').disabled = !$('#exName').value.trim();
}

function bindAddForm() {
  $('#exName').oninput = () => {
    $('#saveExercise').disabled = !$('#exName').value.trim();
  };
  $('#exCategory').onclick = (e) => {
    if (e.target.tagName === 'BUTTON') {
      newExCategory = e.target.dataset.val;
      if (newExCategory === 'cardio') newExIcon = '🏃';
      else if (newExCategory === 'machine') newExIcon = '🏋️';
      updateAddFormUI();
    }
  };
  $('#exMuscle').onclick = (e) => {
    if (e.target.tagName === 'BUTTON') {
      newExMuscle = e.target.dataset.val;
      $$('#exMuscle button').forEach(b => b.classList.toggle('active', b.dataset.val === newExMuscle));
    }
  };
  $('#saveExercise').onclick = () => {
    const name = $('#exName').value.trim();
    if (!name) return;
    const ex = {
      id: uid(),
      name,
      category: newExCategory,
      muscle: newExCategory === 'cardio' ? 'Всё тело' : newExMuscle,
      icon: newExIcon,
      custom: true,
      notes: $('#exNotes').value.trim() || '',
      sets: [],
      cardio: [],
    };
    state.exercises.push(ex);
    saveState();
    closeAll();
    renderList();
    showToast('Упражнение добавлено ✓');
  };
}

// ============ SHEET УПРАВЛЕНИЕ ============
function openSheet(id) {
  $('#overlay').classList.add('show');
  $('#' + id).classList.add('show');
}
function closeAll() {
  $('#overlay').classList.remove('show');
  $$('.sheet').forEach(s => s.classList.remove('show'));
}

// ============ НАВИГАЦИЯ ============
function switchTab(tab) {
  currentTab = tab;
  $$('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
  if (tab === 'exercises') {
    $('#pageTitle').textContent = 'Упражнения';
    $('#addBtn').style.display = 'flex';
    renderChips();
    renderList();
  } else {
    renderHistory();
    $('#addBtn').style.display = 'none';
  }
}

// ============ ИНИЦИАЛИЗАЦИЯ ============
function init() {
  bindAddForm();
  $('#addBtn').onclick = openAddExercise;
  $('#overlay').onclick = closeAll;
  $$('[data-close]').forEach(b => b.onclick = closeAll);

  $$('.tab').forEach(tab => {
    tab.onclick = () => switchTab(tab.dataset.tab);
  });

  switchTab('exercises');
}

init();
</script>
